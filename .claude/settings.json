{
  "enabledPlugins": {
    "superpowers@superpowers-marketplace": true,
    "rcc@Reflexive-Claude-Code": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit:*)",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-test.py\"",
            "timeout": 120,
            "statusMessage": "執行測試中..."
          }
        ]
      }
    ]
  }
}
