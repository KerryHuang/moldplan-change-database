<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MoldplanDbSwitcher.ViewModels"
             x:Class="MoldplanDbSwitcher.Views.ReportingDeployPage"
             x:DataType="vm:ReportingDeployViewModel">
  <DockPanel Margin="8">
    <Border DockPanel.Dock="Top" BorderBrush="Gray" BorderThickness="1" Padding="8" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Text="{Binding TargetDatabaseName, StringFormat='目標 DB: {0}'}" FontWeight="Bold" />
        <TextBlock Text="{Binding SchemaExists, StringFormat='Schema: {0}'}" />
        <TextBlock Text="{Binding TableCount, StringFormat='Tables: {0}'}" />
        <TextBlock Text="{Binding ViewCount, StringFormat='Views: {0}'}" />
        <TextBlock Text="{Binding ProcedureCount, StringFormat='SP: {0}'}" />
        <Button Content="重新掃描" Command="{Binding ScanEnvironmentCommand}" />
        <TextBlock Text="掃描中⋯" Foreground="DodgerBlue"
                   VerticalAlignment="Center" IsVisible="{Binding IsBusy}" />
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="目標報表庫：" VerticalAlignment="Center" />
        <TextBox Text="{Binding TargetDatabaseName}" Width="200" />
        <TextBlock Text="來源主庫：" VerticalAlignment="Center" />
        <TextBox Text="{Binding SourceDatabaseName}" Width="200" />
        <TextBlock Text="Job Owner：" VerticalAlignment="Center" />
        <TextBox Text="{Binding JobOwner}" Width="100" />
      </StackPanel>
      <TextBlock Text="⚠ 報表庫須與來源主庫位於同一個 SQL Server instance（View 以三段式跨庫參照）。"
                 Foreground="Orange" TextWrapping="Wrap" Margin="0,4,0,0" />
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button Content="部署全部 (01→07)" Command="{Binding DeployAllCommand}"
                IsEnabled="{Binding CanDeployAll}"
                ToolTip.Tip="{Binding IsFullyDeployed, Converter={x:Static BoolConverters.Not}, ConverterParameter=已完整部署，無需再執行}" />
        <Button Content="部署 Daily Job (05)" Command="{Binding DeployDailyJobCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="部署 Hourly Job (06)" Command="{Binding DeployHourlyJobCommand}"
                IsEnabled="{Binding !IsBusy}" />
        <Button Content="匯出 SQL" Click="OnExportSqlClick" IsEnabled="{Binding !IsBusy}" />
        <Button Content="⚠ 移除全部 (98)" Background="Crimson" Foreground="White"
                IsEnabled="{Binding CanDropAll}"
                Click="OnDropAllClick" />
        <TextBlock Text="✓ 已完整部署" Foreground="LimeGreen" VerticalAlignment="Center"
                   IsVisible="{Binding IsFullyDeployed}" />
      </StackPanel>
    </StackPanel>

    <DataGrid ItemsSource="{Binding Steps}" IsReadOnly="True" AutoGenerateColumns="True" />
  </DockPanel>
</UserControl>
